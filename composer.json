{
  "name": "lavertia/support",
  "description": "PHP component contracts and safe versioned JSON protocol for Lavertia.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Lavertia\\Support\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "laravel/pint": "^1.27"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "test:smoke": "@php -d zend.assertions=1 -d assert.exception=1 tests/smoke.php",
    "lint": "@php vendor/bin/pint --test"
  }
}
